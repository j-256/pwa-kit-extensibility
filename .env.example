# Local dev config for `npm start`, loaded by config/load-env.js via dev-server.js.
# Copy the relevant lines into real files. Anything matching .env or .env.* is
# git-ignored except this example, so no secret value is committed.
#
# Files, in increasing specificity:
#   .env            base config, always loaded (put DEPLOY_TARGET here)
#   .env.<target>   overlaid when DEPLOY_TARGET resolves to <target>; an unset
#                   target resolves to "default" (config/default.js)
#
# Precedence per key: an explicit `VAR=x npm start` wins, then .env.<target>,
# then .env, then your shell. Exception: PWA_KIT_SLAS_CLIENT_SECRET always takes
# the file value over an ambient shell value (so a stale export cannot shadow
# it), unless the file value expands to empty.
#
# ${VAR} expands from your shell environment, so secrets stay out of these files.

# ----- .env  (base) -----
# Default target for a bare `npm start`; override per run, e.g.
#   DEPLOY_TARGET=default npm start   # loads config/default.js
DEPLOY_TARGET=sbx

# ----- .env.<target>  (one per private-client target) -----
# The shell var name embeds that target's backing instance id (realm_instance)
# PWA_KIT_SLAS_CLIENT_SECRET=${SLAS_PRIVATE_CLIENT_SECRET_<instance>}
